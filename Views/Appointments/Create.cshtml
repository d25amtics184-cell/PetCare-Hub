@model Appointment
@{ ViewData["Title"] = "Book appointment"; }
<div class="form-card"><h2>Book a vet appointment 🩺</h2><p class="text-secondary">This submits a local demo request; it does not contact a real clinic.</p>
@if (((Microsoft.AspNetCore.Mvc.Rendering.SelectList)ViewBag.PetId).Count() == 0) { <div class="alert alert-info">Please <a asp-controller="Pets" asp-action="Create">add a pet profile</a> first.</div> }
<form asp-action="Create" method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="mb-3"><label asp-for="PetId" class="form-label">Pet</label><select asp-for="PetId" asp-items="ViewBag.PetId" class="form-select"><option value="">Choose your pet</option></select><span asp-validation-for="PetId" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="AppointmentDate" class="form-label">Date and time</label><input asp-for="AppointmentDate" class="form-control" type="datetime-local" /><span asp-validation-for="AppointmentDate" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Reason" class="form-label"></label><textarea asp-for="Reason" class="form-control" rows="3" placeholder="Vaccination, routine check-up..."></textarea><span asp-validation-for="Reason" class="text-danger"></span></div>
<button class="btn btn-primary">Submit request</button> <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a></form></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
