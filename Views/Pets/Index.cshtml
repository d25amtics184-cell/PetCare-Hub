@model IEnumerable<Pet>
@{ ViewData["Title"] = "My Pets"; }
<div class="d-flex justify-content-between align-items-center mb-3"><div><h2>My pets 🐾</h2><p class="text-secondary mb-0">Manage each pet's basic profile.</p></div><a class="btn btn-primary" asp-action="Create">＋ Add pet</a></div>
@if (!Model.Any()) { <div class="empty-state"><div class="display-4">🐕</div><h4>No pet profiles yet</h4><p>Add your first pet to get started.</p><a asp-action="Create" class="btn btn-primary">Add a pet</a></div> }
else { <div class="row g-3">@foreach (var pet in Model) { <div class="col-md-6 col-lg-4"><div class="pet-card"><div class="display-5">@(pet.Species.ToLower().Contains("cat") ? "🐱" : "🐶")</div><h4 class="mt-2">@pet.Name</h4><span class="badge text-bg-light">@pet.Species</span><p class="mt-3 mb-1"><strong>Breed:</strong> @(pet.Breed ?? "Not specified")</p><p class="mb-1"><strong>Age:</strong> @pet.Age year(s)</p><p><strong>Gender:</strong> @(pet.Gender ?? "Not specified")</p><div class="d-flex gap-2"><a asp-action="Edit" asp-route-id="@pet.Id" class="btn btn-outline-primary btn-sm">Edit</a><a asp-action="Delete" asp-route-id="@pet.Id" class="btn btn-outline-danger btn-sm">Delete</a></div></div></div> }</div> }
