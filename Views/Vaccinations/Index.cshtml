@model IEnumerable<Vaccination>
@{ ViewData["Title"] = "Vaccinations"; }
<div class="d-flex justify-content-between align-items-center mb-3"><div><h2>Vaccination records 💉</h2><p class="text-secondary mb-0">Keep track of vaccines and due dates.</p></div><a asp-action="Create" class="btn btn-primary">＋ Add record</a></div>
@if (!Model.Any()) { <div class="empty-state"><div class="display-4">💗</div><h4>No records yet</h4><p>Add a vaccination record for one of your pets.</p></div> }
else { <div class="table-responsive bg-white rounded-4 shadow-sm"><table class="table align-middle mb-0"><thead><tr><th>Pet</th><th>Vaccine</th><th>Given on</th><th>Next due</th><th>Reminder</th></tr></thead><tbody>@foreach (var v in Model) { <tr><td>@v.Pet?.Name</td><td>@v.VaccineName</td><td>@v.GivenOn.ToString("dd MMM yyyy")</td><td>@(v.NextDueDate?.ToString("dd MMM yyyy") ?? "Not set")</td><td>@if (v.NextDueDate.HasValue && v.NextDueDate.Value.Date < DateTime.Today) { <span class="badge text-bg-danger">Overdue</span> } else if (v.NextDueDate.HasValue && v.NextDueDate.Value.Date <= DateTime.Today.AddDays(30)) { <span class="badge text-bg-warning">Due soon</span> } else { <span class="badge text-bg-success">On track</span> }</td></tr> }</tbody></table></div> }
